rules_version = '2';

// Aturan keamanan Firestore — Kelurahan Matani Satu
// • statistik/ringkasan : angka agregat (tanpa NIK/nama) → boleh dibaca publik
// • penduduk/*          : data pribadi → HANYA admin terdaftar
// • admins/{uid}        : daftar admin, dikelola lewat Console / scripts/set-admin.mjs
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function validPenduduk(d) {
      return d.keys().hasAll(['nik', 'nama', 'tempatLahir', 'tanggalLahir', 'jenisKelamin', 'alamat'])
        && d.nik is string && d.nik.matches('^[0-9]{16}$')
        && d.nama is string && d.nama.size() > 0 && d.nama.size() <= 120
        && d.jenisKelamin in ['L', 'P']
        && d.tanggalLahir is string && d.tanggalLahir.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    match /penduduk/{id} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin() && validPenduduk(request.resource.data);
    }

    match /statistik/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /admins/{uid} {
      // admin hanya boleh membaca dokumennya sendiri; penulisan via Console/Admin SDK
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
